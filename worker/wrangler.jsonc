{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "openclaw-memory-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],

  // Observability: enables Workers Logs for this Worker in production
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  
  // Vectorize binding for semantic search
  "vectorize": [
    {
      "binding": "VECTORIZE",
      "index_name": "agent-memories"
    }
  ],
  
  // Workers AI for embeddings
  "ai": {
    "binding": "AI"
  },
  
  // R2 buckets for agent workspaces (customize these)
  // Add your own buckets here
  "r2_buckets": [
    { "binding": "R2_MEMORY", "bucket_name": "hermes-memory" },
    { "binding": "R2_FILES", "bucket_name": "hermes-files" },
    { "binding": "R2_TRADING_MEMORY", "bucket_name": "trading-memory" },
    { "binding": "R2_TRADING_FILES", "bucket_name": "trading-files" }
  ],
  
  // Environment variables
  "vars": {
    "EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
    "ALLOWED_AGENTS": "cleo",
    "WORKER_SERVICE_NAME": "openclaw-memory-worker"
  }
}
