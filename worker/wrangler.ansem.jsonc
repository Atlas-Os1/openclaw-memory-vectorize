{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ansem-memory-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "agent-memories" }],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "R2_MEMORY", "bucket_name": "trading-memory" },
    { "binding": "R2_FILES", "bucket_name": "trading-files" },
    { "binding": "R2_TRADING_MEMORY", "bucket_name": "trading-memory" },
    { "binding": "R2_TRADING_FILES", "bucket_name": "trading-files" }
  ],
  "vars": {
    "EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5",
    "ALLOWED_AGENTS": "ansem",
    "TRADING_ARCHIVE_AGENT": "ansem",
    "WORKER_SERVICE_NAME": "ansem-memory-worker"
  }
}
