{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "atlas-memory-worker",
  "main": "src/index.ts",
  "compatibility_date": "2025-01-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true, "head_sampling_rate": 1 },
  "vectorize": [{ "binding": "VECTORIZE", "index_name": "agent-memories" }],
  "ai": { "binding": "AI" },
  "r2_buckets": [
    { "binding": "R2_MEMORY", "bucket_name": "atlas-lanes-memory" },
    { "binding": "R2_FILES", "bucket_name": "atlas-lanes-files" }
  ],
  "vars": { "EMBEDDING_MODEL": "@cf/baai/bge-base-en-v1.5" }
}
